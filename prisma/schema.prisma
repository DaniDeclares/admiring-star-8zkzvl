generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name          String
  phone              String?
  email              String?
  organization_name  String?
  city               String?
  state              String?
  source_id          String?              @db.Uuid
  source_text        String?
  status             String               @default("new")
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dd_estimates       dd_estimates[]
  dd_followup_tasks  dd_followup_tasks[]
  dd_invoices        dd_invoices[]
  dd_jobs            dd_jobs[]
  fieldops_estimates fieldops_estimates[]
  followups          followups[]
  marketing_sources  marketing_sources?   @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  requests           ServiceRequest[]

  @@index([source_id], map: "idx_leads_source_id")
  @@index([status], map: "idx_leads_status")
  @@map("leads")
}

model ServiceRequest {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId             String?              @map("lead_id") @db.Uuid
  division_id        BigInt?
  service_id         String?              @db.Uuid
  service_category   String?
  service_needed     String?
  location_address   String?
  timeline           String?
  budget_range       String?
  request_details    String?
  property_details   Json                 @default("{}")
  document_details   Json                 @default("{}")
  event_details      Json                 @default("{}")
  courier_details    Json                 @default("{}")
  govcon_details     Json                 @default("{}")
  status             String               @default("new")
  priority           String               @default("normal")
  quote_amount       Decimal?             @db.Decimal(10, 2)
  internal_notes     String?
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dd_estimates       dd_estimates[]
  dd_jobs            dd_jobs[]
  fieldops_estimates fieldops_estimates[]
  followups          followups[]
  divisions          divisions?           @relation(fields: [division_id], references: [id], onUpdate: NoAction)
  lead               Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services           services?            @relation(fields: [service_id], references: [id], onUpdate: NoAction)

  @@index([division_id], map: "idx_service_requests_division_id")
  @@index([leadId], map: "idx_service_requests_lead_id")
  @@index([status], map: "idx_service_requests_status")
  @@map("service_requests")
}

