# Never commit production secrets. Configure these in Vercel/Supabase secrets.
# Generated from an actual audit of every process.env.* reference in api/ and
# src/ (2026-09-16) -- this file previously documented only the notification
# variables below and was missing everything else the app actually reads.

# Supabase
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
REACT_APP_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REACT_APP_STRIPE_CONNECT_CLIENT_ID=
REACT_APP_STRIPE_CONNECT_REDIRECT_URL=

# Notification infrastructure
RESEND_API_KEY=
RESEND_FROM_EMAIL="DANI DECLARES <noreply@danideclares.biz>"
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_EMAIL=
NOTIFICATION_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=
TEAM_NOTIFICATION_WEBHOOK_URL=
CRON_SECRET=
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_BATCH_SIZE=20
PROVIDER_ROUTING_BATCH_SIZE=

# Analytics
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# Sentry browser monitoring
REACT_APP_SENTRY_DSN=

# Print-on-demand (Printify)
PRINTIFY_API_TOKEN=
PRINTIFY_STORE_ID=

# Owner HQ first-party integrations — SERVER ONLY
# Never commit real credentials or tokens. Configure in Vercel/Supabase secrets.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=https://danideclares.com/api/integrations/asana/callback

# Notion: preferred for the single DANI workspace is an internal connection token.
NOTION_TOKEN=
# Public OAuth is optional for future multi-workspace support:
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://danideclares.com/api/integrations/notion/callback

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://danideclares.com/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Do not add Google Voice credentials. Google Voice is not treated as a public API here.
# Add programmable telephony credentials only after an explicit provider decision.
